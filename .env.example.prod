# ============================================
# Bens Seguros — Production Environment
# Copy to /opt/bens-seguros/.env on VPS
# Generate secrets with: openssl rand -base64 32
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
# ============================================

# === APP ===
NODE_ENV=production

# === DATABASES (hosts are Docker container names) ===
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}
MONGODB_URL=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongodb:27017/bens-chat?replicaSet=rs0&authSource=admin
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Database admin connection (bypasses RLS, used for DI repos and worker jobs)
# DATABASE_ADMIN_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# === DATABASE CREDENTIALS ===
DB_USER=bens_prod
DB_PASSWORD=
DB_NAME=bens_seguros
MONGO_USER=bens_mongo
MONGO_PASSWORD=
REDIS_PASSWORD=

# === AUTH ===
AUTH_SECRET=
SOCKET_JWT_SECRET=

# === URLs ===
FRONTEND_URL=https://app.bensseg.com
API_URL=https://api.bensseg.com
CHAT_SERVER_URL=https://chat.bensseg.com

# === COOKIES (REQUIRED for cross-subdomain auth: app <-> api) ===
COOKIE_DOMAIN=.bensseg.com

# === STORAGE (Cloudflare R2) ===
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bens-seguros

# === AI (required for chatbot) ===
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# === EMAIL (required for invitations and notifications) ===
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=Bens Seguros <noreply@bensseg.com>

# === META (WhatsApp, Messenger, Instagram — shared Facebook App) ===
# META_WEBHOOK_VERIFY_TOKEN=

# === META CENTRALIZED APP (OAuth + Embedded Signup) ===
# META_APP_ID=your_facebook_app_id
# META_APP_SECRET=your_facebook_app_secret
# META_OAUTH_REDIRECT_URI=https://chat.bensseg.com/meta/auth/callback
# NEXT_PUBLIC_META_APP_ID=your_facebook_app_id

# === CHAT WEBHOOK (public URL for auto-registering webhooks with Meta) ===
# CHAT_WEBHOOK_PUBLIC_URL=https://chat.bensseg.com/chat/webhook/meta

# === INTERNAL API (chat-worker to server HMAC auth) ===
# Required if using AI chatbot with lead capture
# Generate with: openssl rand -base64 32
# INTERNAL_API_URL=http://server:3001
# INTERNAL_API_SECRET=

# === MONITORING ===
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# === SECURITY (REQUIRED — PII encryption) ===
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# === DEPLOYMENT (optional — defaults work for Docker Compose) ===
# PORT=3001
# HOST=0.0.0.0

# === BAILEYS WHATSAPP (optional — chat-worker only) ===
# BAILEYS_SESSIONS_DIR=./baileys-sessions
# BAILEYS_LOG_LEVEL=warn

# Consultar Placa — vehicle lookup by plate (SCRUM-56). Charges per query (R$ 0,31 in low volume).
# CONSULTAR_PLACA_EMAIL=
# CONSULTAR_PLACA_API_KEY=

# Max organizations a single user can create (Better Auth organizationLimit). Default 3 (C4 Fase 0 billing).
# MAX_ORGS_PER_USER=3

# Signup mode (Fase 1 billing). REQUIRED em prod = 'closed' (apenas invite onboarding).
# Quando reabrir self-serve com checkout (Fase 7), trocar pra 'self_serve'.
SIGNUP_MODE=closed

# === DOCKER ===
DOCKERHUB_USERNAME=
TAG=latest
