{
  "name": "bens-seguros",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:architecture": "node --test scripts/architecture-guidance.test.mjs scripts/architecture-cruiser.test.mjs",
    "test:watch": "turbo test:watch",
    "arch:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:push:dev": "pnpm --filter @repo/db db:push:dev",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.9",
      "@hono/node-server": "1.19.11",
      "effect": "3.20.0",
      "jsondiffpatch": "0.7.2",
      "lodash": "4.17.23"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "dependency-cruiser": "^18.3.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "turbo": "^2.9.3"
  }
}
