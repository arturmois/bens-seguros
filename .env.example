# ============================================
# Bens Seguros — Development Environment
# Copy to .env and fill in required values
# ============================================

# === APP ===
NODE_ENV=development

# === DATABASES ===
DATABASE_URL=postgresql://bens:bens_dev@localhost:5432/bens_seguros
# Database admin connection (bypasses RLS, used for DI repos and internal operations)
# DATABASE_ADMIN_URL=postgresql://bens:bens_dev@localhost:5432/bens_seguros
MONGODB_URL=mongodb://localhost:27017/bens_chat?directConnection=true
REDIS_URL=redis://:bens_dev@localhost:6379

# === AUTH ===
AUTH_SECRET=your-auth-secret-at-least-32-characters-long
SOCKET_JWT_SECRET=your-socket-jwt-secret

# === URLs ===
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
CHAT_SERVER_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAT_SERVER_URL=http://localhost:3002

# === COOKIES (required for cross-subdomain auth in production) ===
# COOKIE_DOMAIN=.bensseg.com

# === STORAGE (Cloudflare R2) ===
# STORAGE_PROVIDER=local (default) | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bens-seguros

# === AI (multi-provider) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === EMAIL ===
RESEND_API_KEY=
# RESEND_FROM_ADDRESS=Bens Seguros <noreply@bens.com.br>

# === META (WhatsApp, Messenger, Instagram — shared Facebook App) ===
META_WEBHOOK_VERIFY_TOKEN=

# === META CENTRALIZED APP (OAuth + Embedded Signup) ===
# META_APP_ID=your_facebook_app_id
# META_APP_SECRET=your_facebook_app_secret
# META_OAUTH_REDIRECT_URI=http://localhost:3002/meta/auth/callback
# NEXT_PUBLIC_META_APP_ID=your_facebook_app_id

# === CHAT WEBHOOK (public URL for auto-registering webhooks with Meta) ===
# Defaults to CHAT_SERVER_URL/chat/webhook/meta if not set
# CHAT_WEBHOOK_PUBLIC_URL=https://chat.bensseg.com/chat/webhook/meta

# === INTERNAL API (chat-worker to server HMAC auth) ===
INTERNAL_API_URL=http://localhost:3001
# INTERNAL_API_SECRET=your-internal-secret-at-least-32-characters

# === MONITORING ===
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# === SECURITY (PII encryption) ===
# Required. Generate a real key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# === DEPLOYMENT (optional — platforms set PORT automatically) ===
# PORT=3001
# HOST=0.0.0.0

# === BAILEYS WHATSAPP (optional — chat-worker only) ===
# BAILEYS_SESSIONS_DIR=./baileys-sessions
# BAILEYS_LOG_LEVEL=warn
